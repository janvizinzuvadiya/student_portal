import './App.css';
import { useState } from 'react';

export default function RadioBox()
{
    const [clr,setClr] = useState('');

    const handleClr = (e) => 
    {
        setClr(e.target.value);;
    }

    return(

        <div className='radiobox' style={{ backgroundColor:clr }}>

            <h1> RadioBox</h1>

            <input type='radio' name='color' value='pink' onChange={handleClr} />Pink
            <br />
            <input type='radio' name='color' value='lightblue' onChange={handleClr} />Blue
            <br />
            <input type='radio' name='color' value='lightgreen' onChange={handleClr} />Green
            <br />
            <input type='radio' name='color' value='gray' onChange={handleClr} />Gray

        </div>

    );

}




check box

import './App.css';
import { useState } from 'react';

export default function CheckBox()
{

    const [hobby , setHobby ] = useState([]);

    const handlechange = (e) =>
    {
        const {value,checked} = e.target;
        if(checked)
        {
            setHobby([...hobby,value]);
        }
        else
        {
            setHobby(hobby.filter((item) => item!== value));
        }
    }

    return( 
        <div className='checkbox'>
            <h1>CheckBox</h1>
            <hr />
            <br />

                <input type='checkbox' name='hobby' value='dance' onChange={handlechange}/>Dance
                <br />

                <input type='checkbox' name='hobby' value='cricket' onChange={handlechange}/>Cricket
                <br />

                <input type='checkbox' name='hobby' value='reading' onChange={handlechange}/>Reading
                <br />

                <input type='checkbox' name='hobby' value='swimming' onChange={handlechange}/>Swimming
                <br />

                <input type='checkbox' name='hobby' value='travelling' onChange={handlechange}/>Travelling
                <br />

                <input type='checkbox' name='hobby' value='photography' onChange={handlechange}/>Photography
                <br />

                <input type='checkbox' name='hobby' value='painting' onChange={handlechange}/>Painting
                <br />

                <input type='checkbox' name='hobby' value='gardening' onChange={handlechange}/>Gardening

                  <br />  <br />
            <p> Selected Item : {hobby.join(", ")}</p>
        </div>
    );
}